# Copy this file to the project root as .env and fill in the real values.
# The backend (config.py / llm_client.py) reads these from the project-root .env.

ENV=production
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_TIMEOUT_SECONDS=30

# Single-server setup: RAG and backend are both on 127.0.0.1, so this is NOT needed.
# Only set it if the RAG service runs on another host/port.
# RAG_SEARCH_URL=http://127.0.0.1:8001/api/rag/search
