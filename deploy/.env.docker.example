# Docker Compose 环境变量示例
# 复制到项目根目录再启动：
#   cp deploy/.env.docker.example .env
#   docker compose up -d --build

# 后端运行环境：必须是 production。
# 若为 development，backend/main.py 的 check_database() 在表结构不一致时会
# drop_all + create_all 重建数据库，容器里等于每次启动删库。
ENV=production

# DeepSeek API Key：必填。
# 不填则正反方辩论/输入解析全部走 mock，演示会"不智能"（但链路仍可跑通）。
DEEPSEEK_API_KEY=sk-xxxx

# LLM 请求超时（秒）
DEEPSEEK_TIMEOUT_SECONDS=30

# 前端对宿主机暴露的端口，默认 8088。
# 说明：Windows 上 5173 常被 Hyper-V 保留端口段占用（bind: access permissions），
#       所以 Docker 方案默认用 8088；Linux 服务器可设为 5173 与 deploy/start.sh 保持一致。
# FRONTEND_PORT=8088

# 可选：覆盖镜像构建时的国内源
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
